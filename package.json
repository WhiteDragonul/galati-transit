{
  "name": "galati-transit",
  "private": true,
  "version": "0.1.0",
  "description": "Hartă 3D interactivă, open source, a transportului public din Galați (Transurb)",
  "license": "MIT",
  "author": "WhiteDragonul",
  "repository": {
    "type": "git",
    "url": "https://github.com/WhiteDragonul/galati-transit.git"
  },
  "homepage": "https://whitedragonul.github.io/galati-transit/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:fetch": "tsx scripts/fetch-osm.ts",
    "data:build": "tsx scripts/build-data.ts",
    "data": "npm run data:fetch && npm run data:fetch-roads && npm run data:fetch-transurb && npm run data:build && npm run data:verify",
    "typecheck": "tsc --noEmit",
    "snapshot": "tsx scripts/snapshot.ts",
    "data:fetch-transurb": "tsx scripts/fetch-transurb.ts",
    "data:verify": "tsx scripts/verify-data.ts",
    "test": "tsx --test scripts/lib/match.test.ts src/plan.test.ts",
    "data:fetch-roads": "tsx scripts/fetch-roads.ts",
    "trailer:assets": "tsx scripts/trailer/capture-assets.ts",
    "trailer:render": "tsx scripts/trailer/render.ts"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "mp4-muxer": "^5.2.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "motion": "^13.5.0"
  }
}
